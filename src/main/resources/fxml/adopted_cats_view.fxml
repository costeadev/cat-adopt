<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../styles/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="catadopt.controller.AdoptedCatsController">
	<children>
		<ScrollPane fitToWidth="true" prefHeight="330" prefWidth="652.0">
			<content>
				<GridPane fx:id="adoptedCatsContainer" hgap="20" prefWidth="760" vgap="20" />
			</content>
		</ScrollPane>
		<Button layoutX="402" layoutY="349" onAction="#onDeleteClick" styleClass="freeAdopt" text="Liberar" />
		<Button layoutX="513" layoutY="349" onAction="#onBackClick" styleClass="keepAdopt" text="Regresar" />
	</children>
</AnchorPane>
